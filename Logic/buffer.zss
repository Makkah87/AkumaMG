#Command Buffer System
[StateDef -4]

############################################################################
#								Map Table									
############################################################################
#								special_cancel
#								special_cancel_timer
#								super_cancel
#								super_cancel_timer
############################################################################



if map(special_cancel_timer) > 0 {mapadd {map: "special_cancel_timer"; value:-1}}
if map(super_cancel_timer) > 0 {mapadd{map: "super_cancel_timer"; value:-1}}

#Special Reset
if (stateno = [200,699] || map(special_cancel_timer)=0) {mapset {map: "special_cancel"; value:0}}
#if (stateno = [200,699] || ctrl = 1 || map(special_cancel_timer)=0) {mapset {map: "special_cancel"; value:0}}

###########################################################################
#load Special States
###########################################################################
#Gou Hadou
	if command = "Gou1" && statetype = S {mapset {map:"special_cancel"; value:1000}
							mapset {map:"special_cancel_timer"; value : 30}
							}
	
	if command = "Gou2" && statetype = S {mapset {map:"special_cancel"; value:1015}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "Gou3" && statetype = S {mapset {map:"special_cancel"; value:1020}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
#Shakunetsu Gou Hadou
	if command = "metsu1"{mapset {map:"special_cancel"; value:1160}
							mapset {map:"special_cancel_timer"; value :30}
							}
	
	if command = "metsu2"{mapset {map:"special_cancel"; value:1165}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "metsu3"{mapset {map:"special_cancel"; value:1170}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
#Gou Shoryu
	if command = "shoryu1"{mapset {map:"special_cancel"; value:1030}
							mapset {map:"special_cancel_timer"; value :30}
							}
	
	if command = "shoryu2"{mapset {map:"special_cancel"; value:1035}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "shoryu3"{mapset {map:"special_cancel"; value:1040}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
#Tatsumaki Zankuu Kyaku
	if command = "tatsu1" && statetype = S {mapset {map:"special_cancel"; value:1060}
							mapset {map:"special_cancel_timer"; value :30}
							}
	
	if command = "tatsu2" && statetype = S {mapset {map:"special_cancel"; value:1065}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "tatsu3" && statetype = S {mapset {map:"special_cancel"; value:1070}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
#Hyakki Shuu
	if command = "hyakki1"{mapset {map:"special_cancel"; value:1110}
							mapset {map:"special_cancel_timer"; value :30}
							}
	
	if command = "hyakki2"{mapset {map:"special_cancel"; value:1120}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "hyakki3"{mapset {map:"special_cancel"; value:1130}
							mapset {map:"special_cancel_timer"; value :30}
							}

###########Air							
#Gou Zankuu
	if command = "Gou1" && statetype = A {mapset {map:"special_cancel"; value:1140}
							mapset {map:"special_cancel_timer"; value :30}
							}
	
	if command = "Gou2" && statetype = A {mapset {map:"special_cancel"; value:1145}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "Gou3" && statetype = A {mapset {map:"special_cancel"; value:1150}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
#Air Tatsumaki Zankuu Kyaku
	if command = "tatsu1" && statetype = A {mapset {map:"special_cancel"; value:1080}
							mapset {map:"special_cancel_timer"; value :30}
							}
	
	if command = "tatsu2" && statetype = A {mapset {map:"special_cancel"; value:1081}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "tatsu3" && statetype = A {mapset {map:"special_cancel"; value:1082}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
#Tenma Kuujin Kyaku
	if command = "kujin1" && statetype = A {mapset {map:"special_cancel"; value:1085}
							mapset {map:"special_cancel_timer"; value :30}
							}
	
	if command = "kujin2" && statetype = A {mapset {map:"special_cancel"; value:1095}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "kujin3" && statetype = A {mapset {map:"special_cancel"; value:1100}
							mapset {map:"special_cancel_timer"; value :30}
							}


######################################################################################################
#Hyper Combos
######################################################################################################
#Misogi
	if (command = "misogi")&& power >= 3000{mapset {map:"super_cancel"; value:3120}
							mapset {map:"super_cancel_timer"; value :30}
							}							
#Messatsu Gou Shoryu
	if command = "gousho"{mapset {map:"super_cancel"; value:3000}
							mapset {map:"super_cancel_timer"; value :30}
							}
#Messatsu Gou Hadou
	if command = "messatsu"{mapset {map:"super_cancel"; value:3010}
							mapset {map:"super_cancel_timer"; value :30}
							}
#Shun Goku Satsu							
	if command = "shun" && power >= 3000 {mapset {map:"super_cancel"; value:3050}
							mapset {map:"super_cancel_timer"; value :30}
							}
							
#Messatsu Gou Rassen
	if command = "rassen" && statetype = S {mapset {map:"uper_cancel"; value:3040}
							mapset {map:"super_cancel_timer"; value :30}
							}


#############Reversal Buffer
###Super Attack
if (power >= 1000 && anim = 5120 && !animtime && statetype != A && map(super_cancel_timer))  && map(super_cancel) {changestate{value:map(super_cancel)}
	mapset {map:"super_cancel_timer"; value :30}
}


###Special Attack
if (anim = 5120 && !animtime && statetype != A)  && map(special_cancel){changestate{value:map(special_cancel)}
	mapset {map:"special_cancel_timer"; value :30}
}