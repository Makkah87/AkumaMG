#Command Buffer System
[StateDef -4]
 assertspecial{flag: nokovelocity}

############################################################################
#								Map Table									
############################################################################
#								special_cancel
#								special_cancel_timer
#								special_cancel
#								special_cancel_timer
############################################################################



if map(special_cancel_timer) > 0 {mapadd {map: "special_cancel_timer"; value:-1}}
#if map(super_cancel_timer) > 0 {mapadd{map: "super_cancel_timer"; value:-1}}

#Special Reset
if (stateno = [200,699] || ctrl = 1 || map(special_cancel_timer)=0) {mapset {map: "special_cancel"; value:0}}

###########################################################################
#load Special States
###########################################################################
#Gou Hadou
	if command = "Gou1" && statetype = S {mapset {map:"special_cancel"; value:1000}
							mapset {map:"special_cancel_timer"; value : 30}
							}
	
	if command = "Gou2" && statetype = S {mapset {map:"special_cancel"; value:1015}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
	if command = "Gou3" && statetype = S {mapset {map:"special_cancel"; value:1020}
							mapset {map:"special_cancel_timer"; value :30}
							}
							
